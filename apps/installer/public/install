#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

origin="${ARGUS_INSTALLER_ORIGIN:-https://argus-installer.pages.dev}"
tmp="$(mktemp -d)"
verbose=0
spinner_pid=""
spinner_message=""

cleanup() {
  clear_spinner
  rm -rf -- "$tmp"
}
trap cleanup EXIT

case "${1:-}" in
  --verbose|-v) verbose=1; shift ;;
  "") ;;
  *) printf 'Argus installer: unknown option %s\n' "$1" >&2; exit 2 ;;
esac
[[ $# -eq 0 ]] || { printf 'Argus installer: unexpected arguments\n' >&2; exit 2; }

use_color=0
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  use_color=1
fi

paint() {
  local code="$1" text="$2"
  if [[ "$use_color" == "1" ]]; then
    printf '\033[%sm%s\033[0m' "$code" "$text"
  else
    printf '%s' "$text"
  fi
}

clear_spinner() {
  if [[ -n "$spinner_pid" ]]; then
    kill "$spinner_pid" >/dev/null 2>&1 || true
    wait "$spinner_pid" 2>/dev/null || true
    spinner_pid=""
    [[ -t 1 ]] && printf '\r\033[2K'
  fi
  spinner_message=""
}

start_spinner() {
  spinner_message="$1"
  if [[ ! -t 1 ]]; then
    printf '%s %s\n' "$(paint '36' '  ›')" "$spinner_message"
    spinner_pid=""
    return
  fi

  (
    local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏') i=0
    while :; do
      printf '\r\033[2K%s %s' "$(paint '36' "  ${frames[$((i % ${#frames[@]}))]}")" "$spinner_message"
      i=$((i + 1))
      sleep 0.1
    done
  ) &
  spinner_pid=$!
}

finish_spinner() {
  local success="$1" message="${2:-$spinner_message}"
  if [[ -n "$spinner_pid" ]]; then
    kill "$spinner_pid" >/dev/null 2>&1 || true
    wait "$spinner_pid" 2>/dev/null || true
    spinner_pid=""
    printf '\r\033[2K'
  fi
  if [[ "$success" == "1" ]]; then
    printf '%s %s\n' "$(paint '32' '  ✓')" "$message"
  else
    printf '%s %s\n' "$(paint '31' '  ✗')" "$message" >&2
  fi
  spinner_message=""
}

begin_stage() {
  local message="$1" animated="${2:-0}"
  if [[ -n "$spinner_message" ]]; then
    finish_spinner 1 "$spinner_message"
  fi
  if [[ "$animated" == "1" ]]; then
    start_spinner "$message"
  else
    spinner_message="$message"
    printf '%s %s\n' "$(paint '36' '  ›')" "$message"
  fi
}

concise_install_output() {
  local line passthrough=0
  spinner_pid=""
  spinner_message=""
  trap clear_spinner EXIT

  while IFS= read -r line; do
    if [[ "$passthrough" == "1" ]]; then
      printf '%s\n' "$line"
      continue
    fi

    case "$line" in
      "[1/7] Checking host requirements") begin_stage "Checking host requirements" 1 ;;
      "[2/7] Authenticating to private GHCR") begin_stage "Authenticating with the Argus registry" ;;
      "[3/7] Collecting control-plane configuration") begin_stage "Collecting control-plane configuration" ;;
      "[3/7] Installing managed-node bundle") begin_stage "Installing managed-node bundle" 1 ;;
      "[4/7] Downloading and verifying release") begin_stage "Downloading and verifying Argus" 1 ;;
      "[5/7] Configuring services") begin_stage "Configuring Argus services" 1 ;;
      "[6/7] Starting the control plane") begin_stage "Starting the control plane" 1 ;;
      "[7/7] Verifying health") begin_stage "Verifying installation health" 1 ;;
      "Argus first-test installation is ready."|"Argus managed node is connected.")
        [[ -n "$spinner_message" ]] && finish_spinner 1 "$spinner_message"
        printf '\n%s\n' "$line"
        passthrough=1
        ;;
      "[argus] existing Argus environment found;"*|"[argus] pinning requested version"*|"[argus] preserving existing Caddyfile")
        printf '    %s\n' "${line#\[argus\] }"
        ;;
      *) ;;
    esac
  done

  clear_spinner
  trap - EXIT
}

printf '%s\n' "$(paint '1;36' 'Argus install')"
printf '    Source: %s\n\n' "$origin"

start_spinner "Downloading verified installer"
if ! curl -fsS "$origin/install.sh" -o "$tmp/install.sh" \
  || ! curl -fsS "$origin/install.sh.sha256" -o "$tmp/install.sh.sha256"; then
  finish_spinner 0 "Could not download the installer"
  exit 1
fi
finish_spinner 1 "Installer downloaded"

start_spinner "Verifying installer checksum"
if ! (cd "$tmp" && sha256sum -c install.sh.sha256 >/dev/null); then
  finish_spinner 0 "Installer checksum verification failed"
  exit 1
fi
finish_spinner 1 "Installer checksum verified"
printf '\n'

run_installer() {
  if [[ -r /dev/tty ]]; then
    bash "$tmp/install.sh" </dev/tty
  else
    bash "$tmp/install.sh"
  fi
}

if [[ "$verbose" == "1" ]]; then
  run_installer
else
  set +e
  run_installer | concise_install_output
  status=${PIPESTATUS[0]}
  set -e
  if [[ "$status" -ne 0 ]]; then
    printf '\n%s Installation failed\n' "$(paint '31' '  ✗')" >&2
    printf '    Re-run with: curl -fsSL %q/install | sudo bash -s -- --verbose\n' "$origin" >&2
    exit "$status"
  fi
fi
