# Same PostgreSQL server/database as the Argus control plane.
# Payload stores its tables in ARGUS_CONTENT_DB_SCHEMA, not public.
DATABASE_URL=postgres://argus:argus@localhost:5432/argus
ARGUS_CONTENT_DB_SCHEMA=argus_content
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
PAYLOAD_PUBLIC_URL=http://localhost:3001

# Server-to-server credential for mirroring Argus project identity into Payload.
# Do not expose this to browsers.
ARGUS_CONTENT_SYNC_TOKEN=replace-with-a-different-32-character-secret

# Development only. Leave false in production and use committed Payload migrations.
PAYLOAD_DB_PUSH=true
