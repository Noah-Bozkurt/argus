[Unit]
Description=Argus privileged helper
After=local-fs.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
Group=argus
RuntimeDirectory=argus
RuntimeDirectoryMode=0750
EnvironmentFile=-/etc/argus/helper.env
# A normal update owns /run/lock/argus-update.lock, so this is a no-op while
# argusctl update is actively restarting the Helper. After a hard reboot the
# lock is free and an incomplete transaction is restored before Helper startup.
ExecStartPre=/usr/local/bin/argusctl recover-update
ExecStart=/usr/local/bin/argus-helper
Restart=on-failure
RestartSec=2
PrivateTmp=yes
ProtectHome=yes
# The Helper intentionally performs allowlisted host mutations (APT, systemd,
# Docker, firewall and transactional restore). ProtectSystem=strict would make
# those operations fail by mounting the host filesystem read-only. The security
# boundary is the local Unix socket plus the typed/validated Helper API.
ProtectSystem=no

[Install]
WantedBy=multi-user.target
