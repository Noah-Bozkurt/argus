# Image source. For the first private test these images are expected in GHCR.
ARGUS_REGISTRY=ghcr.io/noah-bozkurt
ARGUS_VERSION=main

# Public direct-DNS hostnames. A/AAAA records must point to this server.
ARGUS_DOMAIN=argus.example.com
ARGUS_CONTENT_DOMAIN=content.argus.example.com
ARGUS_NODE_DOMAIN=nodes.argus.example.com

# Generated by the installer. Keep this file mode 0600.
ARGUS_POSTGRES_PASSWORD=replace-with-random-secret
ARGUS_WEB_API_TOKEN=replace-with-random-secret
ARGUS_WORKER_TOKEN=replace-with-random-secret
ARGUS_CONTENT_SYNC_TOKEN=replace-with-random-secret
PAYLOAD_SECRET=replace-with-random-secret

# Initial fixed server-side operator identity used by the current pre-auth Web UI.
ARGUS_ORG_ID=00000000-0000-0000-0000-000000000000
ARGUS_USER_ID=00000000-0000-0000-0000-000000000000

# Optional GitHub API token used by Argus project repository integration.
ARGUS_GITHUB_TOKEN=
ARGUS_RUST_LOG=info
